SELECT 
	TRIM(CONCAT(first_name, ' ', last_name)) AS cleaned_name,
	UPPER(LEFT(department, 3)) AS dept_code,
	LEN(TRIM(corporate_email)) AS email_length,
	YEAR(hire_date) AS hire_year,
	DATENAME(month, hire_date) AS hire_month,
	CASE	
		WHEN salary > 90000 THEN 'Tier 1'
		WHEN salary BETWEEN 60000 AND 90000 THEN 'Tier 2'
		ELSE 'Tier 3' 
	END AS salary_tier_tag
FROM employees
WHERE YEAR(hire_date) >= 2020
ORDER BY department ASC, salary DESC;
